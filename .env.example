REMOTE_DB_HOST=host
REMOTE_DB_USER=postgres
REMOTE_DB_PASS=secret
REMOTE_DB_DATABASE=postgres

LOCAL_DB_USER=postgres
LOCAL_DB_PASS=postgres
LOCAL_DB_DATABASE=postgres

QA_DB_HOST=host
QA_DB_USER=postgres
QA_DB_PASS=secret
QA_DB_DATABASE=postgres

BASTION_URL=redis-host.internal:6379
REDIS_DEV_USER=ec2-user
REDIS_DEV_URL=bastion-host.example.com
# REDIS_DEV_SSH_KEY_PATH in your .env needs to be a relative path from the project root
# (e.g., ssh/id_rsa instead of /Users/westondev/.ssh/id_rsa),
# since Docker COPY only works with files inside the build context.
REDIS_DEV_SSH_KEY_PATH=path/to/ssh/key
